[Unit]
Description=KeyStats input statistics daemon
Documentation=https://github.com/0x5c0f/KeyStats.Linux
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/keystats-daemon
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
